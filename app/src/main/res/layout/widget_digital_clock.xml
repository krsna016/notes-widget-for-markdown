<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/digital_clock_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@android:color/transparent"
    android:padding="2dp">

    <!-- Date Header (e.g. WEDNESDAY, OCTOBER 28) -->
    <TextClock
        android:id="@+id/digital_clock_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:format12Hour="EEEE, MMMM d"
        android:format24Hour="EEEE, MMMM d"
        android:textColor="#E6FFFFFF"
        android:textSize="18sp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.08"
        android:textAllCaps="true"
        android:shadowColor="#99000000"
        android:shadowDx="0"
        android:shadowDy="2"
        android:shadowRadius="6" />

    <!-- Big Bold Apple/Mac Lockscreen Time (Spanning Full Area) -->
    <TextClock
        android:id="@+id/digital_clock_time"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="64sp"
        android:autoSizeMaxTextSize="140sp"
        android:autoSizeStepGranularity="2sp"
        android:format12Hour="h:mm"
        android:format24Hour="HH:mm"
        android:textColor="#FFFFFFFF"
        android:textSize="115sp"
        android:fontFamily="sans-serif-black"
        android:includeFontPadding="false"
        android:shadowColor="#B0000000"
        android:shadowDx="0"
        android:shadowDy="4"
        android:shadowRadius="12" />

</LinearLayout>
