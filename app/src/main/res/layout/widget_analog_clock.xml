<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/analog_clock_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="8dp">

    <AnalogClock
        android:id="@+id/analog_clock_view"
        android:layout_width="155dp"
        android:layout_height="155dp"
        android:dial="@drawable/ic_clock_dial"
        android:hand_hour="@drawable/ic_clock_hour_hand"
        android:hand_minute="@drawable/ic_clock_minute_hand"
        android:hand_second="@drawable/ic_clock_second_hand" />

    <TextView
        android:id="@+id/analog_clock_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="✦ TAP TO REVEAL DINCHARYA ✦"
        android:textColor="#A78BFA"
        android:textSize="10sp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.05" />

</LinearLayout>
