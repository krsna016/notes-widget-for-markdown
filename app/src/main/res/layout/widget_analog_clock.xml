<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/analog_clock_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:padding="2dp">

    <AnalogClock
        android:id="@+id/analog_clock_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:dial="@drawable/ic_clock_dial"
        android:hand_hour="@drawable/ic_clock_hour_hand"
        android:hand_minute="@drawable/ic_clock_minute_hand"
        android:hand_second="@drawable/ic_clock_second_hand" />

</FrameLayout>
